<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titulo }} — {{ titulo_sitio }}</title>
<style>{{ css }}</style>
</head>
<body>
<header class="cabecera">
  <div class="wrap">
    <p class="kicker">{{ titulo_sitio }}</p>
    <p class="rango-fechas">Semana del {{ semana.lunes | fecha }} al {{ semana.viernes | fecha }} &middot; Publicado {{ fecha_generacion | fecha }}</p>
    <h1 class="titulo-informe">{{ titulo }}</h1>
    <p class="bajada">{{ bajada }}</p>

    <div class="cards">
      <div class="card">
        <div class="label">S&amp;P 500</div>
        <div class="valor {{ clase_var(s1.spx.var) }}">{{ s1.spx.var | pct }}</div>
      </div>
      {% if s1.vix %}
      <div class="card">
        <div class="label">VIX</div>
        <div class="valor">{{ s1.vix.cierre | num(1) }} <span class="{{ clase_var(s1.vix.var) }}" style="font-size:13px;">({{ s1.vix.var | pct }})</span></div>
      </div>
      {% endif %}
      {% if s3.disponible %}
      <div class="card">
        <div class="label">Dólar (índice sintético)</div>
        <div class="valor {{ clase_var(s3.indice_usd) }}">{{ s3.indice_usd | pct }}</div>
      </div>
      {% endif %}
      {% if s2.disponible %}
      <div class="card">
        <div class="label">Mejor sector</div>
        <div class="valor positivo">{{ s2.mejor.nombre }} {{ s2.mejor.var | pct }}</div>
      </div>
      <div class="card">
        <div class="label">Peor sector</div>
        <div class="valor negativo">{{ s2.peor.nombre }} {{ s2.peor.var | pct }}</div>
      </div>
      <div class="card">
        <div class="label">Spread cíclicos−defensivos</div>
        <div class="valor {{ clase_var(s2.spread_ciclicos_defensivos) }}">{{ s2.spread_ciclicos_defensivos | pct }}</div>
      </div>
      {% endif %}
    </div>
  </div>
</header>

<main class="wrap">

  <section class="seccion" id="resumen">
    <div class="num-badge"><span class="barra"></span><span class="num">01</span></div>
    <h2 class="titulo-seccion">Resumen ejecutivo</h2>

    <div class="balance-bloque">
      <span style="font-size:13px;color:var(--gris-texto);white-space:nowrap;">Balance de la semana</span>
      <div class="balance-pista">
        <div class="balance-marca" style="left:{{ 50 + (balance / 2) }}%;"></div>
      </div>
      <span class="balance-valor">{{ "%+d" | format(balance) }}</span>
    </div>

    {% for parrafo in resumen %}
    <p class="parrafo">{{ parrafo }}</p>
    {% endfor %}

    <h2 class="titulo-seccion" style="margin-top:22px;font-size:16px;">Claves de la semana</h2>
    <ul class="claves">
      {% for clave in claves %}
      <li>{{ clave }}</li>
      {% endfor %}
    </ul>
  </section>

  <section class="seccion" id="panorama">
    <div class="num-badge"><span class="barra"></span><span class="num">02</span></div>
    <h2 class="titulo-seccion">Panorama de mercado</h2>
    <div class="tabla-wrap">
      <table>
        <thead>
          <tr><th>Índice</th><th>Cierre</th><th>Var. semanal</th><th>Mejor sesión</th><th>Peor sesión</th></tr>
        </thead>
        <tbody>
          {% for ticker, ind in s1.indices.items() %}
          <tr>
            <td>{{ ind.nombre }}</td>
            <td>{{ ind.cierre | num(2) }}</td>
            <td class="{{ clase_var(ind.var) }}">{{ ind.var | pct }}</td>
            <td class="positivo">{{ ind.mejor_sesion.fecha | fecha }} ({{ ind.mejor_sesion.var | pct }})</td>
            <td class="negativo">{{ ind.peor_sesion.fecha | fecha }} ({{ ind.peor_sesion.var | pct }})</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if lectura_panorama %}
    <p class="parrafo lectura">{{ lectura_panorama }}</p>
    {% endif %}
  </section>

  <section class="seccion" id="sectores">
    <div class="num-badge"><span class="barra"></span><span class="num">03</span></div>
    <h2 class="titulo-seccion">Rotación sectorial</h2>
    {% if s2.disponible %}
    <p class="parrafo">{{ s2.positivos }} de {{ s2.total }} sectores en positivo. Promedio cíclicos: {{ s2.prom_ciclicos | pct }} &middot; Promedio defensivos: {{ s2.prom_defensivos | pct }}.</p>
    {% for sec in s2.sectores %}
    <div class="barra-fila">
      <span class="etiqueta">{{ sec.nombre }} ({{ sec.ticker }})</span>
      <span class="pista"><span class="relleno {{ 'pos' if sec.var >= 0 else 'neg' }}" style="width:{{ sec.barra_pct }}%;"></span></span>
      <span class="valor {{ clase_var(sec.var) }}">{{ sec.var | pct }}</span>
    </div>
    {% endfor %}
    {% if lectura_sectores %}
    <p class="parrafo lectura" style="margin-top:10px;">{{ lectura_sectores }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="macro">
    <div class="num-badge"><span class="barra"></span><span class="num">04</span></div>
    <h2 class="titulo-seccion">Divisas y macro global</h2>
    {% if s3.disponible %}
    <div class="tabla-wrap">
      <table>
        <thead>
          <tr><th>Divisa</th><th>Cierre (par)</th><th>Var. semanal (divisa)</th></tr>
        </thead>
        <tbody>
          {% for par in s3.fx %}
          <tr>
            <td>{{ par.nombre }}</td>
            <td>{{ par.cierre | num(4) }}</td>
            <td class="{{ clase_var(par.var_divisa) }}">{{ par.var_divisa | pct }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="tabla-wrap">
      <table>
        <thead>
          <tr><th>Indicador</th><th>Cierre</th><th>Var. semanal</th></tr>
        </thead>
        <tbody>
          {% for ticker, m in s3.macro.items() %}
          <tr>
            <td>{{ m.nombre }}</td>
            <td>{{ m.cierre | num(2) }}</td>
            <td class="{{ clase_var(m.var) }}">{{ m.var | pct }}</td>
          </tr>
          {% endfor %}
          {% if s3.tasa_10y %}
          <tr>
            <td>Tasa 10Y (FRED)</td>
            <td>{{ s3.tasa_10y.nivel | num(2) }}%</td>
            <td class="{{ 'positivo' if s3.tasa_10y.var_pb >= 0 else 'negativo' }}">{{ "%+.0f" | format(s3.tasa_10y.var_pb) }} pb</td>
          </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
    {% if lectura_macro %}
    <p class="parrafo lectura">{{ lectura_macro }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="flujos">
    <div class="num-badge"><span class="barra"></span><span class="num">05</span></div>
    <h2 class="titulo-seccion">Flujos: institucionales vs. minoristas (proxies)</h2>
    {% if s4.disponible %}
    {% for spread in s4.spreads %}
    <div class="barra-fila">
      <span class="etiqueta">{{ spread.etiqueta }}</span>
      <span class="pista"><span class="relleno {{ 'pos' if spread.valor >= 0 else 'neg' }}" style="width:{{ spread.barra_pct }}%;"></span></span>
      <span class="valor {{ clase_var(spread.valor) }}">{{ spread.valor | pct }}</span>
    </div>
    {% endfor %}
    {% if s4.volumen_relativo is not none %}
    <p class="parrafo" style="margin-top:10px;">Volumen de SPY vs. promedio de las 4 semanas previas: <strong class="{{ clase_var(s4.volumen_relativo) }}">{{ s4.volumen_relativo | pct }}</strong>.</p>
    {% endif %}
    {% if lectura_flujos %}
    <p class="parrafo">{{ lectura_flujos }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="amplitud">
    <div class="num-badge"><span class="barra"></span><span class="num">06</span></div>
    <h2 class="titulo-seccion">Amplitud del mercado</h2>
    {% if s6.disponible %}
    <div class="stats-grid">
      <div class="stat">
        <div class="label">Suben / Bajan / Planos</div>
        <div class="valor">{{ s6.suben }} / {{ s6.bajan }} / {{ s6.planos }}</div>
      </div>
      <div class="stat">
        <div class="label">Amplitud</div>
        <div class="valor">{{ s6.amplitud_pct | pct(0, false) }}</div>
      </div>
      <div class="stat">
        <div class="label">Retorno promedio (cías.)</div>
        <div class="valor {{ clase_var(s6.retorno_promedio) }}">{{ s6.retorno_promedio | pct }}</div>
      </div>
      <div class="stat">
        <div class="label">Retorno mediana (cías.)</div>
        <div class="valor {{ clase_var(s6.retorno_mediana) }}">{{ s6.retorno_mediana | pct }}</div>
      </div>
      {% if s6.pct_sobre_ema50 is not none %}
      <div class="stat">
        <div class="label">Sobre EMA 50</div>
        <div class="valor">{{ s6.pct_sobre_ema50 | pct(0, false) }}</div>
      </div>
      <div class="stat">
        <div class="label">Sobre EMA 200</div>
        <div class="valor">{{ s6.pct_sobre_ema200 | pct(0, false) }}</div>
      </div>
      {% endif %}
      {% if s6.amplitud_media_diaria is not none %}
      <div class="stat">
        <div class="label">Amplitud media diaria</div>
        <div class="valor">{{ s6.amplitud_media_diaria | pct(0, false) }}</div>
      </div>
      {% endif %}
    </div>
    <p class="parrafo">N efectivo: {{ s6.n_efectivo }} componentes del S&amp;P 500 (retorno del índice: {{ s6.var_indice | pct }}).</p>
    {% if lectura_amplitud %}
    <p class="parrafo lectura">{{ lectura_amplitud }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="distribucion">
    <div class="num-badge"><span class="barra"></span><span class="num">07</span></div>
    <h2 class="titulo-seccion">Distribución de retornos semanales</h2>
    {% if s7.disponible %}
    <div class="histograma">
      {% for b in s7.buckets %}
      <div class="barra-vert">
        <div class="conteo">{{ b.conteo }}</div>
        <div class="columna {{ 'pos' if b.positivo else 'neg' }}" style="height:{{ b.barra_pct }}px;"></div>
        <div class="etiqueta">{{ b.etiqueta }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="parrafo" style="margin-top:14px;">Distribución sobre {{ s7.total }} compañías.</p>
    {% if lectura_distribucion %}
    <p class="parrafo lectura">{{ lectura_distribucion }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="movers">
    <div class="num-badge"><span class="barra"></span><span class="num">08</span></div>
    <h2 class="titulo-seccion">Ganadores y perdedores</h2>
    {% if s8.disponible %}
    <h3 class="subtitulo">Top {{ s8.ganadores | length }} subas</h3>
    <div class="tabla-wrap">
      <table>
        <thead><tr><th>Ticker</th><th>Compañía</th><th>Sector</th><th>Var. semanal</th></tr></thead>
        <tbody>
          {% for f in s8.ganadores %}
          <tr>
            <td>{{ f.ticker }}</td>
            <td>{{ f.nombre }}</td>
            <td>{{ f.sector }}</td>
            <td class="positivo">{{ f.var | pct }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <h3 class="subtitulo">Top {{ s8.perdedores | length }} bajas</h3>
    <div class="tabla-wrap">
      <table>
        <thead><tr><th>Ticker</th><th>Compañía</th><th>Sector</th><th>Var. semanal</th></tr></thead>
        <tbody>
          {% for f in s8.perdedores %}
          <tr>
            <td>{{ f.ticker }}</td>
            <td>{{ f.nombre }}</td>
            <td>{{ f.sector }}</td>
            <td class="negativo">{{ f.var | pct }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if lectura_top_movers %}
    <p class="parrafo lectura" style="margin-top:10px;">{{ lectura_top_movers }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

  <section class="seccion" id="earnings">
    <div class="num-badge"><span class="barra"></span><span class="num">09</span></div>
    <h2 class="titulo-seccion">Temporada de resultados</h2>
    {% if s9.disponible %}
    {% if s9.n_reportes > 0 %}
    <div class="stats-grid">
      <div class="stat">
        <div class="label">Reportes</div>
        <div class="valor">{{ s9.n_reportes }}</div>
      </div>
      <div class="stat">
        <div class="label">% de beats</div>
        <div class="valor">{{ s9.pct_beats | pct(0, false) }}</div>
      </div>
      <div class="stat">
        <div class="label">Sorpresa media</div>
        <div class="valor {{ clase_var(s9.sorpresa_media) }}">{{ s9.sorpresa_media | pct }}</div>
      </div>
    </div>
    <div class="tabla-wrap">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Ticker</th><th>Compañía</th><th>EPS real</th><th>EPS est.</th><th>Sorpresa</th><th>Reacción</th></tr>
        </thead>
        <tbody>
          {% for r in s9.reportes %}
          <tr>
            <td>{{ r.fecha | fecha }}</td>
            <td>{{ r.ticker }}</td>
            <td>{{ r.nombre }}</td>
            <td>{{ r.eps_actual | num(2) }}</td>
            <td>{{ r.eps_estimado | num(2) }}</td>
            <td class="{{ clase_var(r.sorpresa_pct) }}">{{ r.sorpresa_pct | pct }}</td>
            <td class="{{ clase_var(r.var_precio) }}">{{ r.var_precio | pct }} ({{ r.timing }})</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if lectura_earnings %}
    <p class="parrafo lectura">{{ lectura_earnings }}</p>
    {% endif %}
    {% else %}
    <p class="seccion-no-disp">Datos no disponibles esta semana.</p>
    {% endif %}
  </section>

</main>

<footer class="wrap">
  <div>Semana reportada: {{ semana.lunes | fecha }} — {{ semana.viernes | fecha }}</div>
  <div class="disclaimer">{{ disclaimer }}</div>
</footer>
</body>
</html>
